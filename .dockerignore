# Ignore all files by default
*

# White list only the required files
!package-lock.json
!package.json
!upload/.gitkeep
!src/
!config/
!config.env
!configTenant.json
!babel.config.js
!ecosystem.config.js
!modclean.config.js
!jest.config.js
!tsconfig.json
!packages
!typings.json
!docker-entrypoint.sh
!vite.config.ts

# Dependencies are installed inside the image, never copy the host ones
**/node_modules
# Rebuilt in the image by the transformers prepublish script
packages/transformers/lib

# Model archives are downloaded from GitHub by their catalog url, not read from the image
src/app/custom/models/archives
